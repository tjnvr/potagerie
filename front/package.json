{
  "name": "potagerie-front",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --silent",
    "dev": "pnpm messages && vite",
    "build": "pnpm messages && vite build",
    "preview": "vite preview",
    "check": "pnpm messages && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm messages && vitest run",
    "e2e": "pnpm messages && playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@inlang/plugin-message-format": "^4.6.0",
    "@playwright/test": "1.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
